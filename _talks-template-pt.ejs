<div class="talks-grid">
<% for (var i = 0; i < items.length; i++) { var t = items[i]; var f = t.lang === 'pt-br' ? 'br' : 'gb'; var l = t.lang === 'pt-br' ? 'PT-BR' : 'EN'; %>
<div class="talk-card">
<div class="talk-meta"><span class="talk-year"><%- t.year %></span><span class="talk-lang"><span class="fi fi-<%= f %>"></span> <%= l %></span></div>
<div class="talk-title"><%- t.title %></div>
<div class="talk-event"><%- t.event %></div>
<% if (t.location) { %><div class="talk-location"><i class="bi bi-geo-alt"></i> <%- t.location === 'Remote' ? 'Remoto' : t.location %></div><% } %>
<div class="talk-links"><% if (t.slides) { %><a href="<%- t.slides %>" class="talk-link" target="_blank" rel="noopener">Slides ↗</a> <% } %><% if (t.video) { %><a href="<%- t.video %>" class="talk-link" target="_blank" rel="noopener">Vídeo ↗</a> <% } %><% if (t.code) { %><a href="<%- t.code %>" class="talk-link" target="_blank" rel="noopener">Código ↗</a><% } %></div>
</div>
<% } %>
</div>
